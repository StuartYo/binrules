{
  "name": "binrules",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "BinRules: answers which bin an item goes in strictly from a city's official sorting rules, cites the exact entry, and refuses when the rules do not cover it. Nemotron on Nebius Token Factory maps words to entries; code decides the bin.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data": "node scripts/build-data.mjs",
    "eval": "tsx eval/run.ts",
    "report": "tsx eval/report.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "lucide-react": "1.56.0",
    "next": "16.4.0",
    "openai": "7.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
